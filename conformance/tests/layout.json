{
  "tests": [
    {
      "id": "LAYOUT-001.1",
      "rule": "LAYOUT-001",
      "domain": "layout",
      "setup": {
        "viewport": [
          200,
          100
        ],
        "tree": {
          "type": "column",
          "children": [
            {
              "type": "box",
              "id": "a",
              "props": {
                "w": 50,
                "h": 30
              }
            },
            {
              "type": "box",
              "id": "b",
              "props": {
                "w": 20,
                "h": 10
              }
            }
          ]
        }
      },
      "expect": {
        "rects": {
          "a": [
            0,
            0,
            200,
            30
          ],
          "b": [
            0,
            30,
            200,
            10
          ]
        },
        "measured": {
          "a": [
            50,
            30
          ],
          "b": [
            20,
            10
          ]
        }
      }
    },
