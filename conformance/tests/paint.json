{
  "tests": [
    {
      "id": "PAINT-001.1",
      "rule": "PAINT-001",
      "domain": "paint",
      "setup": {
        "viewport": [
          100,
          100
        ],
        "tree": {
          "type": "column",
          "props": {
            "cross_align": "start"
          },
          "children": [
            {
              "type": "box",
              "id": "red",
              "props": {
                "w": 60,
                "h": 40,
                "color": "#FF0000FF"
              }
            }
          ]
        }
      },
      "expect": {
        "pixels": [
          {
            "x": 30,
            "y": 20,
            "color": "#FF0000FF"
          },
          {
            "x": 59,
            "y": 39,
            "color": "#FF0000FF"
          },
          {
            "x": 60,
            "y": 20,
            "color": "#000000FF"
          },
          {
            "x": 30,
            "y": 40,
            "color": "#000000FF"
          }
        ],
        "pixel_counts": [
          {
            "color": "#FF0000FF",
            "exact": 2400
          }
        ]
      }
    },
    {
