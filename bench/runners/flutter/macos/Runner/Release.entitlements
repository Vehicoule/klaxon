<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bench runner: the App Sandbox is disabled so the runner inherits the
	     shell's working directory and can write its JSON report to
	     bench/results/flutter/ (a sandboxed app gets a container CWD and may
	     not write outside its container). Local benchmark tool, not a
	     distributed app. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
