    {
      "id": "PAINT-007.1",
      "rule": "PAINT-005",
      "domain": "paint",
      "setup": {
        "viewport": [
          100,
          100
        ],
        "tree": {
          "type": "container",
          "props": {
            "color": "#112233FF",
            "padding": 10
          },
          "children": [
            {
              "type": "box",
              "id": "inner",
              "props": {
                "color": "#445566FF"
              }
            }
          ]
        }
      },
      "expect": {
        "pixels": [
          {
            "x": 5,
            "y": 5,
            "color": "#112233FF"
          },
          {
            "x": 50,
            "y": 50,
            "color": "#445566FF"
          }
        ]
      }
    },
    {
      "id": "PAINT-008.1",
      "rule": "PAINT-006",
      "domain": "paint",
      "setup": {
        "viewport": [
          100,
          60
        ],
        "signals": {
          "tsw": false
        },
        "tree": {
          "type": "column",
          "props": {
            "cross_align": "start"
          },
          "children": [
            {
              "type": "toggle",
              "id": "sw",
              "props": {
                "signal": "tsw"
              }
            }
          ]
        }
      },
      "actions": [
        {
          "op": "pointer",
          "phase": "down",
          "x": 22,
          "y": 12
        },
        {
          "op": "pointer",
          "phase": "up",
          "x": 22,
          "y": 12
        }
      ],
      "expect": {
        "signals": {
          "tsw": true
        },
        "pixels": [
          {
            "x": 10,
            "y": 12,
            "color": "#3B5BDBFF"
          }
        ],
        "events": [
          "change:sw"
        ]
      }
    }
  ]
}