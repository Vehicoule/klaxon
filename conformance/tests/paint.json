    {
      "id": "PAINT-006.1",
      "rule": "PAINT-003",
      "domain": "paint",
      "setup": {
        "viewport": [
          200,
          100
        ],
        "tree": {
          "type": "column",
          "children": [
            {
              "type": "box",
              "id": "a",
              "props": {
                "w": 50,
                "h": 30,
                "damage_overflow": [
                  2,
                  4,
                  6,
                  8
                ]
              }
            },
            {
              "type": "box",
              "id": "b",
              "props": {
                "w": 20,
                "h": 10
              }
            }
          ]
        }
      },
      "actions": [
        {
          "op": "mark_dirty",
          "id": "a"
        },
        {
          "op": "mark_dirty_rect",
          "id": "b",
          "rect": [
            10,
            60,
            20,
            10
          ]
        }
      ],
      "expect": {
        "damage": [
          -2,
          -4,
          208,
          74
        ]
      }
