    {
      "id": "LAYOUT-006.1",
      "rule": "LAYOUT-006",
      "domain": "layout",
      "setup": {
        "viewport": [
          300,
          100
        ],
        "tree": {
          "type": "column",
          "children": [
            {
              "type": "stack",
              "id": "s1",
              "props": {
                "alignment": [
                  1,
                  1
                ]
              },
              "children": [
                {
                  "type": "box",
                  "id": "under",
                  "props": {
                    "w": 300,
                    "h": 50
                  }
                },
                {
                  "type": "box",
                  "id": "over",
                  "props": {
                    "w": 40,
                    "h": 40
                  }
                }
              ]
            },
            {
              "type": "stack",
              "id": "s2",
              "props": {
                "fit": "expand"
              },
              "children": [
                {
                  "type": "box",
                  "id": "tight",
                  "props": {
                    "w": 10,
                    "h": 10
                  }
                }
              ]
            }
          ]
        }
      },
      "expect": {
        "rects": {
          "s1": [
            0,
            0,
            300,
            50
          ],
          "under": [
            0,
            0,
            300,
            50
          ],
          "over": [
            260,
            10,
            40,
            40
          ],
          "s2": [
            0,
            50,
            300,
            100
          ],
          "tight": [
            0,
            50,
            300,
            100
          ]
        }
      },
      "note": "expand fills the parent-offered size (Flutter semantics) — the column offers its full height, so the stack claims 100 and overflows past the viewport; use expanded() for fill-remaining"
    },
